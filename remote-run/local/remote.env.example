# 复制为 remote.env 后填写。不要提交明文密码。
REMOTE_USER=your_user
REMOTE_HOST=your.host.or.ip
REMOTE_PORT=22
REMOTE_ROOT=/home/your_user/vbc-remote

# 可选：如果使用指定私钥，填写绝对路径；为空则使用默认 ssh agent / ~/.ssh。
SSH_KEY=

# 可选：本机低层权重路径。留空时同步脚本会尝试寻找仓库根目录或上一层的 model_38000.pt。
# 示例：LOW_POLICY_LOCAL_PATH=/path/to/publiccheckrollrew_37000.pt
LOW_POLICY_LOCAL_PATH=

# rsync 额外参数。首次同步建议保持默认。
RSYNC_EXTRA_ARGS=
